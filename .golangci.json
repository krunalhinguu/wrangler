{
    "version": "2",
    "linters": {
        "default": "none",
        "enable": [
            "ineffassign",
            "govet",
            "misspell",
            "revive",
            "unused"
        ],
        "settings": {
            "govet": {
                "disable": [
                    "shadow"
                ]
            },
            "revive": {
                "rules": [
                    {
                        "name": "confusing-naming",
                        "disabled": true
                    }
                ]
            }
        },
        "exclusions": {
            "paths": [
                "pkg/generated"
            ]
        }
    },
    "run": {
        "tests": false,
        "relative-path-mode": "cfg",
        "concurrency": 0
    },
    "formatters": {
        "enable": [
            "goimports"
        ]
    }
}